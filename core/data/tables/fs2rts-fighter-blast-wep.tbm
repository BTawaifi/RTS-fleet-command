	+Min Lock Time:							2.0													;; Minimum lock time (in seconds)
	+Lock Pixels/Sec:							70                                        ;; Pixels moved per sec while locking
	+Catch-up Pixels/Sec:					100													;; Pixels moved per sec while catching up
