#Ship Classes
; Compact FS1 models from FSPort 3.7.3, rebuilt as standalone FS2 ship entries.
; Default/allowed weapons intentionally use retail FS2 classes only.
; Physics, reactor and countermeasure values retain the FSPort FS1 profiles.
; Standalone entries must declare these: upstream defaults are zero.
$Name: GTF Apollo
$Short name: TFight4
$Species: Terran
$POF file: fighter04.pof
$Debris:
    +Damage Type: RTS Debris Impact
$Density: 1
$Damp: 0.2
$Rotdamp: 0.35
$Max Velocity: 0.0, 0.0, 60.0
$Rotation Time: 3.2, 3.2, 6.0
$Rear Velocity: 0.0
$Forward accel: 3.0
$Forward decel: 1.5
$Slide accel: 0.0
$Slide decel: 0.0
$Allowed PBanks: ( "Subach HL-7" "Prometheus R" "Vasudan Light Laser" )
$Default PBanks: ( "Subach HL-7" "Prometheus R" )
$Allowed SBanks: ( "Hornet" "Rockeye" "Tempest" )
$Default SBanks: ( "Hornet" "Hornet" )
$SBank Capacity: ( 40, 40 )
$Shields: 350
$Power Output: 2.0
$Max Oclk Speed: 82.0
$Max Weapon Eng: 100.0
$Hitpoints: 240
$Flags: ( "fighter" "in tech database" "generate icon" )
$AI Class: Captain
$Afterburner: YES
 +Aburn Max Vel: 0.0, 0.0, 140.0
 +Aburn For accel: 0.7
 +Aburn Fuel: 300.0
 +Aburn Burn Rate: 50.0
 +Aburn Rec Rate: 25.0
$Countermeasures: 25
$Score: 10
$Subsystem: sensors, 10, 0.0
$Subsystem: communications, 10, 0.0
$Subsystem: engine, 35, 0.0
$Subsystem: weapons, 20, 0.0
$Subsystem: navigation, 10, 0.0

