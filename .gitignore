# Build output and caches
*.pyc
__pycache__/
.pytest_cache/
*.pof.vp

# Staged headless batches are scratch copies of the mod, produced by
# core/tools/prepare_headless_batch.py into the sibling artifacts/headless/runs.
# They hardlink the retail
# .vp files, so committing one would duplicate the entire retail game data in
# the history.
rts-headless-staging/
*.batch.log
core/data/*.log

# Compiled OpenGL shader cache, regenerated by the engine on first run.
data/cache/

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

data/fs2_open.log